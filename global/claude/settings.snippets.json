{
  "language": "繁體中文台灣用語",
  "env": {
    "RIPGREP_CONFIG_PATH": "<echo \"$HOME/.claude/ripgreprc\" 的輸出>"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/controller-context.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/context-size-nudge.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-ci-edit.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/allow-git-c-projects.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/require-issue-session-model.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_ClickUp__clickup_(get_document_pages|update_document_page)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/clickup-doc-nudge.sh\""
          }
        ]
      }
    ]
  }
}
